		(3,2) coordinate(D)
		(2,0) coordinate(C)
		(-1,0) coordinate(B);
		\coordinate (A) at ($(D)+(B)-(C)$)
		($(A)!1/2!(C)$) coordinate (O)
		($(A)!1/2!(B)$) coordinate (M);
