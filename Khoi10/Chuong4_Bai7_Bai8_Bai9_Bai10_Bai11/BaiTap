    (0,0)coordinate(A)
    (4,0)coordinate(B)
    (5,4)coordinate(C)
    (0,3)coordinate(D)
    ;
    \draw(A)--(B)--(C)--(D)--(A);
    \foreach \x/\i in {A/180,B/0,C/10,D/160}{\path ($(\x)+(\i:3mm)$) node{$\x$};}
    \foreach \x in {A,B,C,D}{\draw[fill=black] (\x) circle (1pt);}
