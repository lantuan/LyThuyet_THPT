        \tkzDefPoints{0/6/A, 6/2/B, 8/0/C, 0/0/D, 0/8/E, 9/0/F, 8/8/G}
        \draw[gray!20](\xmin,\ymin) grid (\xmax,\ymax);
        \draw [->](\xmin,0)--(0,0)node[below left]{$O$}--(\xmax,0)node[above]{$x$};
