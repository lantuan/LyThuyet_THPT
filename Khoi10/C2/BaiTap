                \pgfmathsetmacro{\y}{-2*\x+1}
                \draw[gray] (\x,\y)--++(1500:10);
            }           
        \end{scope}
        
        \pgfmathsetmacro{\hsgg}{-1/3}
        \begin{scope}
            \clip (-3,2)--(-3,-3)--(12,-3)--(-3,2);
            \foreach \x in {-1,-.95,...,20}{
