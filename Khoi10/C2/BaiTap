    (0,5) circle(1.3pt) +(10:0.6) node{$15000$};
    \draw
    (0,-1)--(0,6) (-1,0)--(5,0)
    (-1,-1)--(5,5) (-1,5)--(5,-1)
    (-1/2,6)--(3,-1);
    \draw[dashed] (1,0)node[below=3pt]{$3000$}|-(0,3)node[left=2pt]{$9000$} (5/3,0)node[below=12pt]{$5000$}|-(0,5/3)node[left=2pt]{$5000$} (2,0)node[below=22pt]{$6000$}|-(0,2)node[left=2pt]{$6000$};
    \fill
    (0,0)circle(1pt) node[below right=1pt]{$O$};
